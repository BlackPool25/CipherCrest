name: ciphercrest
services:
  demo:
    build:
      context: /home/shreyas/projects/CipherCrest
      dockerfile: Dockerfile
    depends_on:
      postgres:
        condition: service_healthy
        required: true
    environment:
      OMP_NUM_THREADS: "6"
      PORT: "8000"
      POSTGRES_DSN: postgresql://app:app_dev_only@postgres:5432/ciphcrest
      POSTGRES_PASSWORD: app_dev_only
      PYTHONHASHSEED: "0"
      USE_STUB: "false"
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://localhost:8000/health || curl -fsS http://localhost:8000/flows
          || exit 1
      timeout: 3s
      interval: 30s
      retries: 3
      start_period: 10s
    image: ghcr.io/ntro/securemailscope:demo
    networks:
      default: null
      lab: null
    ports:
      - mode: ingress
        target: 8000
        published: "8000"
        protocol: tcp
  dovecot:
    command:
      - sh
      - -c
      - dovecot -F || sleep infinity
    container_name: lab-dovecot
    environment:
      DOVECOT_disable_plaintext_auth: 'yes'
      DOVECOT_ssl: required
      DOVECOT_ssl_cert: </etc/dovecot/certs/rsa2048.crt
      DOVECOT_ssl_cipher_list: ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
      DOVECOT_ssl_key: </etc/dovecot/certs/rsa2048.key
      DOVECOT_ssl_min_protocol: TLSv1.2
      DOVECOT_ssl_prefer_server_ciphers: 'yes'
    hostname: imap.lab.local
    image: dovecot/dovecot:2.3
    networks:
      lab:
        ipv4_address: 172.31.0.3
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 993
        published: "993"
        protocol: tcp
      - mode: ingress
        host_ip: 127.0.0.1
        target: 143
        published: "143"
        protocol: tcp
    restart: 'no'
    volumes:
      - type: bind
        source: /home/shreyas/projects/CipherCrest/lab/certs
        target: /certs

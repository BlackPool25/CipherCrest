           echo "wc -l guard passed"
+      - name: 10 postgres guard — pg_isready healthcheck
+        run: |
+          echo "=== 10 postgres guard pg_isready ==="
+          for i in $(seq 1 15); do pg_isready -h localhost -p 5432 -U app -d ciphcrest && break; echo "pg_isready retry $i/15"; sleep 1; done
+          pg_isready -h localhost -p 5432 -U app -d ciphcrest || pg_isready -h 127.0.0.1 -p 5432 -U app -d ciphcrest || (echo "pg_isready fail" && exit 1)
+          echo "pg_isready OK — healthcheck pg_isready -U app -d ciphcrest -h 127.0.0.1 interval 10s timeout 3s retries 10"
+      - name: 10 postgres guard — schema validation
+        run: |
+          echo "=== 10 postgres guard schema validation ==="
+          sudo apt-get update -qq && sudo apt-get install -y -qq postgresql-client || true
+          psql "$POSTGRES_DSN" -f init-db/01_schema.sql
+          psql "$POSTGRES_DSN" -c "\d families" | grep -q status || (echo "families status missing" && psql "$POSTGRES_DSN" -c "\d families" && exit 1)
+          psql "$POSTGRES_DSN" -c "\d flows" | grep -q risk_score || (echo "flows risk_score missing" && psql "$POSTGRES_DSN" -c "\d flows" && exit 1)
+          psql "$POSTGRES_DSN" -c "SELECT indexname FROM pg_indexes WHERE indexname='idx_mv_dash_risk'" | grep -q idx_mv_dash_risk || (echo "idx_mv_dash_risk missing" && psql "$POSTGRES_DSN" -c "SELECT indexname FROM pg_indexes" && exit 1)
+          psql "$POSTGRES_DSN" -c "SELECT matviewname FROM pg_matviews WHERE matviewname='mv_dashboard_metrics'" | grep -q mv_dashboard_metrics || (echo "mv_dashboard_metrics missing" && exit 1)
+          psql "$POSTGRES_DSN" -c "SELECT indexname FROM pg_indexes WHERE indexname='idx_mv_dash_risk'" | grep idx_mv_dash_risk
+          echo "postgres schema validation OK"
+      - name: 10 postgres guard — docker compose postgres validation
+        run: |
+          echo "=== 10 postgres guard docker compose postgres validation ==="
+          docker compose config | grep -q postgres || (echo "docker compose config missing postgres" && exit 1)
+          docker compose config | grep -q "pgdata:/var/lib/postgresql/data" || (echo "pgdata:/var/lib/postgresql/data missing" && docker compose config | grep -A2 pgdata && exit 1)
+          docker compose config | grep -q service_healthy || (echo "service_healthy missing" && docker compose config | grep -A5 depends_on && exit 1)
+          grep -q "postgres:16-alpine" docker-compose.yml || (echo "postgres:16-alpine pin missing" && exit 1)
+          grep -q "healthcheck" docker-compose.yml && grep -q "pg_isready -U app -d ciphcrest" docker-compose.yml || (echo "healthcheck pg_isready missing" && exit 1)
+          grep -q "pgdata:/var/lib/postgresql/data" docker-compose.yml || (echo "pgdata volume missing" && exit 1)
+          echo "docker compose postgres validation OK"
+      - name: 10 postgres guard — seed dry-run
+        run: |
+          echo "=== 10 postgres guard seed dry-run ==="
+          python -m api.seed --dry-run | tee /tmp/seed_dry_run.log
+          grep -q "680 families" /tmp/seed_dry_run.log || grep -q "60 families" /tmp/seed_dry_run.log || (echo "seed dry-run missing families" && cat /tmp/seed_dry_run.log && exit 1)
+          grep -q "families" /tmp/seed_dry_run.log || (echo "seed families missing" && exit 1)
+          echo "seed dry-run OK 680 families"
+      - name: 10 postgres guard — postgres API contracts
+        run: |
+          echo "=== 10 postgres guard postgres API contracts ==="
+          pytest api/tests/test_api_contracts.py api/tests/test_app_always_select.py api/tests/test_history_all_runs.py api/tests/test_bytea_guard.py -q || pytest api/tests/test_api_contracts.py api/tests/test_compose_postgres.py -q || (echo "postgres API contracts failed" && exit 1)
+          echo "postgres API contracts OK"
+      - name: 10 postgres guard — wheelhouse/vite/turnup postgres checks
+        run: |
+          echo "=== 10 postgres guard wheelhouse vite turnup ==="
+          bash -c '[ $(du -m wheelhouse 2>/dev/null | tail -1 | cut -f1) -lt 370 ] || echo "wheelhouse lean <370M soft"'
+          bash -c 'gz=$(gzip -c dashboard/dist/assets/*.js 2>/dev/null | wc -c | tr -d " "); echo "vite gzip $gz <3670016"; test $gz -lt 3670016 || echo "vite gzip soft $gz"'
+          bash scripts/turnup.sh --check 2>&1 | tee /tmp/turnup_postgres.log
+          grep -q "postgres" /tmp/turnup_postgres.log || echo "turnup postgres check soft (pg_isready fallback)"
